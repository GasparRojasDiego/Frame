{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos base de las ventanas de Frame (principal, flotante de Enfoque y vistazo al horario).",
  "windows": ["main", "minitimer", "schedulepeek"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
