{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame",
  "version": "1.6.4",
  "identifier": "com.frame.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9002",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Frame",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0RjQxMDZDRjgyODU1MQpSV1JSaFlMUEJrRlBBZnM4Z0gzQTYzNjJKdWthZnN6YlpUTWJDSnl4K1Z4TytGazU0aDd1TnRBMAo=",
      "endpoints": [
        "https://github.com/GasparRojasDiego/frame-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "VT Asvent",
    "category": "Productivity",
    "shortDescription": "Sistema Operativo de Productividad",
    "longDescription": "Frame: sistema de productividad personal para la disciplina, el enfoque y la superación. Asignaturas, tareas con recordatorios, sesiones de estudio con calificación diaria, hábitos, calendario, tu música e integraciones de Google, en una app nativa, rápida y offline-first.",
    "copyright": "Copyright © 2026 VT Asvent",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Frame",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
