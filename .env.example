# ============================================================
# Frame — Variables de entorno (local-first + nube)
# Rellena los valores. Este archivo sirve de plantilla (.env no se versiona).
# ============================================================

# --- Supabase (cliente, se inyectan en el bundle) ---
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# --- App ---
# Cuenta que puede abrir el panel «Uso» (debe coincidir con is_frame_owner en Supabase)
VITE_OWNER_EMAIL=
# Redirect base de OAuth en web/desarrollo (el dev server corre en :9002)
VITE_SITE_URL=http://localhost:9002

# --- Google OAuth nativo de la app de escritorio (integraciones) ---
# Google Cloud Console > APIs & Services > Credentials
#   > Create OAuth Client ID > tipo "Desktop app"
# Para clientes Desktop el client_secret NO se considera confidencial
# (documentación oficial de "installed apps" de Google).
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID_DESKTOP.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_DESKTOP

# --- Google OAuth (NO se exponen al cliente) ---
# Se cargan en: Supabase Dashboard > Authentication > Providers > Google
# Origen: Google Cloud Console > APIs & Services > Credentials
#         > OAuth 2.0 Client ID (tipo "Web application")
GOOGLE_OAUTH_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=TU_CLIENT_SECRET
# Authorized redirect URI a registrar en Google Cloud Console:
#   https://TU_PROYECTO.supabase.co/auth/v1/callback
